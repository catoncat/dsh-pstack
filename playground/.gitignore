# Per-worker runtime: DSH home, browser profile, workspaces, evidence.
.workers/
.workers-*/

# Legacy single-instance runtime paths, kept ignored so stale dirs never leak.
.dsh/
.browser/
.workspace/

# Local config with provider keys and allowed routes; copy config.example.json.
config.json
node_modules
*.log
.DS_Store

# Generated per-run stage report; stage1-findings.md is the hand-curated record.
reports/stage1-raw-*.md
reports/stage1-adapted-*.md

# Archived evidence for the audit report; regenerated per run.
reports/evidence/
